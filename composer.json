{
    "name": "awaisjameel/base64filehandler",
    "description": "A Laravel package for handling and storing base64 encoded files.",
    "keywords": [
        "Awais Jameel",
        "laravel",
        "base64filehandler"
    ],
    "homepage": "https://github.com/awaisjameel/base64filehandler",
    "license": "MIT",
    "authors": [
        {
            "name": "Awais Jameel",
            "email": "awais.jameel@ymail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "awaisjameel/mimetypes": "^2.0||^3.0",
        "illuminate/filesystem": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "league/flysystem": "^3.36.0",
        "spatie/laravel-package-tools": "^1.93.3"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "larastan/larastan": "^3.13.2",
        "orchestra/testbench": "^10.12||^11.3",
        "pestphp/pest": "^3.0||^4.7.8||^5.3.3",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-deprecation-rules": "^2.0.5"
    },
    "autoload": {
        "psr-4": {
            "AwaisJameel\\Base64FileHandler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AwaisJameel\\Base64FileHandler\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AwaisJameel\\Base64FileHandler\\Base64FileHandlerServiceProvider"
            ],
            "aliases": {
                "Base64FileHandler": "AwaisJameel\\Base64FileHandler\\Facades\\Base64FileHandler"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
